# ──────────────────────────────────────────────
# Iheme Studio — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# Site URL (used for absolute Open Graph image URLs)
NEXT_PUBLIC_SITE_URL=https://iheme.studio

# Contact form (optional — swap for Resend, Formspree, etc.)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_EMAIL=ifeanyihm@gmail.com

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXXXX
